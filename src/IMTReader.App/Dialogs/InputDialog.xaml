<Window x:Class="IMTReader.App.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource ToolbarBrush}" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8" />
        <TextBox x:Name="ValueBox" Style="{StaticResource FormTextBox}" KeyDown="ValueBox_KeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="确定" Width="80" Click="Ok_Click" IsDefault="True" />
            <Button Style="{StaticResource ToolButton}" Content="取消" Width="80" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
