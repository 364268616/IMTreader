<Window x:Class="IMTReader.App.Dialogs.HighlightListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IMTReader.App"
        Title="高亮列表" Width="760" Height="540" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource ToolbarBrush}" ShowInTaskbar="False">
    <Window.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <Button Style="{StaticResource ToolButton}" Content="刷新" Click="Refresh_Click" DockPanel.Dock="Right" />
            <Button Style="{StaticResource SaveButton}" Content="导出（Markdown）" Click="Export_Click" DockPanel.Dock="Right" Margin="0,0,6,0" />
        </DockPanel>
        <DataGrid x:Name="Grid" Grid.Row="1" Style="{StaticResource ListGrid}" MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="页码" Binding="{Binding PageNumber}" Width="60" />
                <DataGridTextColumn Header="块号" Binding="{Binding BlockNumber}" Width="60" />
                <DataGridTemplateColumn Header="颜色" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="22" Height="14" CornerRadius="3" Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="摘录" Binding="{Binding Excerpt}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Excerpt}" />
                            <Setter Property="FontFamily" Value="{DynamicResource ReadingFontFamily}" />
                            <Setter Property="FontSize" Value="14" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat=MM-dd HH:mm}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock Text="双击跳转到对应文本块" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
            <Button Style="{StaticResource ToolButton}" Content="关闭" Click="Close_Click" DockPanel.Dock="Right" MinWidth="70" />
            <Button Style="{StaticResource PinkButton}" Content="删除选中" Click="Delete_Click" DockPanel.Dock="Right" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="跳转" Click="Jump_Click" DockPanel.Dock="Right" Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</Window>
