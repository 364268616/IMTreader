<Window x:Class="IMTReader.App.Dialogs.ImmersiveReadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:IMTReader.App.Controls"
        Title="沉浸阅读" Width="1120" Height="780" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ReadingBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource ToolButton}" Content="« 上一页" Click="Prev_Click" />
                    <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Content="下一页 »" Click="Next_Click" />
                    <Border Width="1" Background="{StaticResource ToolbarBorderBrush}" Margin="8,4" />
                    <Button Style="{StaticResource ToolButton}" Content="A-" Click="Smaller_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="A+" Click="Larger_Click" />
                    <ComboBox x:Name="FontBox" Width="110" VerticalAlignment="Center" Margin="6,0" SelectionChanged="FontBox_SelectionChanged">
                        <ComboBoxItem Content="楷体" />
                        <ComboBoxItem Content="宋体" />
                        <ComboBoxItem Content="仿宋" />
                        <ComboBoxItem Content="华文楷体" />
                        <ComboBoxItem Content="华文宋体" />
                        <ComboBoxItem Content="微软雅黑" />
                    </ComboBox>
                    <ComboBox x:Name="ThemeBox" Width="90" VerticalAlignment="Center" Margin="6,0" SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem Content="纸色" />
                        <ComboBoxItem Content="明亮" />
                        <ComboBoxItem Content="夜间" />
                    </ComboBox>
                    <ToggleButton x:Name="SimplifiedToggle" Style="{StaticResource ToolToggle}" Content="繁→简" Checked="Option_Changed" Unchecked="Option_Changed" />
                    <ToggleButton x:Name="VerticalToggle" Style="{StaticResource ToolToggle}" Content="竖排" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
                    <ToggleButton x:Name="LinesToggle" Style="{StaticResource ToolToggle}" Content="栏线" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource BlueButton}" Content="复制本页文字" Click="Copy_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="关闭" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="Scroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="10" PreviewMouseWheel="Scroll_PreviewMouseWheel">
            <Grid>
                <ctl:VerticalTextPanel x:Name="VerticalPanel" FontSize="22" />
                <TextBlock x:Name="HorizontalText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="20" LineHeight="38" Padding="36" MaxWidth="900" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
