<Window x:Class="IMTReader.App.Dialogs.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户协议与免责声明" Height="620" Width="720" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ToolbarBrush}"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13"
                   Text="首次使用前请阅读并同意用户协议。其中关于您导入文献的版权、识别结果可能出错、以及免责条款，请特别注意。" />
        <TextBox Grid.Row="1" x:Name="BodyBox" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Microsoft YaHei UI" FontSize="13" Padding="12"
                 Background="{DynamicResource ReadingBackgroundBrush}"
                 Foreground="{DynamicResource ReadingForegroundBrush}" />
        <CheckBox Grid.Row="2" x:Name="AgreeBox" Margin="0,12,0,0"
                  Content="我已阅读并同意《用户协议与免责声明》，尤其是版权保证、结果可能出错及免责条款。"
                  Checked="AgreeBox_Changed" Unchecked="AgreeBox_Changed" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="AcceptButton" Style="{StaticResource PrimaryButton}" Content="同意并继续"
                    Width="110" Click="Accept_Click" IsEnabled="False" />
            <Button Style="{StaticResource ToolButton}" Content="不同意并退出" Width="110" Click="Decline_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
