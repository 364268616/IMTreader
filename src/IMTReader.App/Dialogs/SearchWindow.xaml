<Window x:Class="IMTReader.App.Dialogs.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全文搜索" Width="820" Height="600" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{StaticResource ToolbarBrush}" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="关键词：" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <Button Style="{StaticResource PrimaryButton}" Content="搜索" Click="Search_Click" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="70" />
            <Button Style="{StaticResource SaveButton}" Content="导出结果" Click="Export_Click" DockPanel.Dock="Right" Margin="6,0,0,0" />
            <TextBox x:Name="KeywordBox" Style="{StaticResource FormTextBox}" KeyDown="KeywordBox_KeyDown" FontSize="14" />
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="NormalizeBox" Content="简繁互通 / 异体字互通" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" />
            <CheckBox x:Name="RegexBox" Content="正则表达式" VerticalAlignment="Center" Margin="0,0,16,0" />
            <CheckBox x:Name="LibraryBox" Content="检索整个文献库" VerticalAlignment="Center" Margin="0,0,16,0" Checked="Scope_Changed" Unchecked="Scope_Changed" />
            <TextBlock x:Name="StatsText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="2" Style="{StaticResource ListGrid}" MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="DocColumn" Header="文献" Binding="{Binding DocumentTitle}" Width="160" Visibility="Collapsed" />
                <DataGridTextColumn Header="页码" Binding="{Binding PageNumber}" Width="60" />
                <DataGridTextColumn Header="块号" Binding="{Binding BlockNumber}" Width="60" />
                <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="60" />
                <DataGridTextColumn Header="搜索结果" Binding="{Binding Snippet}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Snippet}" />
                            <Setter Property="FontFamily" Value="{DynamicResource ReadingFontFamily}" />
                            <Setter Property="FontSize" Value="14" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock Text="双击或点「跳转」定位到本块" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" DockPanel.Dock="Left" />
            <Button Style="{StaticResource ToolButton}" Content="关闭" Click="Close_Click" DockPanel.Dock="Right" MinWidth="70" />
            <Button Style="{StaticResource PrimaryButton}" Content="跳转到选中项" Click="Jump_Click" DockPanel.Dock="Right" Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</Window>
