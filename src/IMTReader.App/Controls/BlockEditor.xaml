<UserControl x:Class="IMTReader.App.Controls.BlockEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IMTReader.App"
             Margin="0,0,0,8">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Border x:Name="Root" CornerRadius="8" BorderThickness="1"
            BorderBrush="{DynamicResource BlockBorderBrush}"
            Background="{DynamicResource BlockBackgroundBrush}"
            Padding="12,9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
                <TextBlock x:Name="LabelText" DockPanel.Dock="Left" FontWeight="SemiBold" Foreground="#3E7A63" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="MetaText" DockPanel.Dock="Left" Margin="10,0,0,0" Foreground="#9AA59C" FontSize="11" VerticalAlignment="Center" />
                <Button x:Name="MenuButton" DockPanel.Dock="Right" Style="{DynamicResource ToolButton}" Padding="6,2" MinHeight="20"
                        ToolTip="本块操作" Click="MenuButton_Click">
                    <TextBlock Text="&#xE712;" FontFamily="{DynamicResource IconFont}" FontSize="12" Foreground="#8A948C" />
                </Button>
            </DockPanel>
            <RichTextBox x:Name="Rtb" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource ReadingForegroundBrush}"
                         FontFamily="{DynamicResource ReadingFontFamily}"
                         AcceptsReturn="True" AcceptsTab="False" IsUndoEnabled="True"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                         SpellCheck.IsEnabled="False"
                         GotKeyboardFocus="Rtb_GotKeyboardFocus" TextChanged="Rtb_TextChanged"
                         PreviewMouseLeftButtonDown="Rtb_PreviewMouseLeftButtonDown">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="LineHeight" Value="1.6" />
                    </Style>
                </RichTextBox.Resources>
                <RichTextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制(_C)" Command="ApplicationCommands.Copy" />
                        <MenuItem Header="剪切(_X)" Command="ApplicationCommands.Cut" />
                        <MenuItem Header="粘贴(_V)" Command="ApplicationCommands.Paste" />
                        <Separator />
                        <MenuItem Header="高亮选中文字" Click="HighlightMenu_Click" />
                        <MenuItem Header="取消选中文字的高亮" Click="UnhighlightMenu_Click" />
                        <Separator />
                        <MenuItem Header="查字典（汉典）" Click="DictionaryMenu_Click" />
                        <MenuItem Header="朗读选中文字" Click="SpeakMenu_Click" />
                        <MenuItem Header="复制并附带出处" Click="CopyCitationMenu_Click" />
                        <MenuItem Header="AI 助手…" Click="AiMenu_Click" />
                    </ContextMenu>
                </RichTextBox.ContextMenu>
            </RichTextBox>
        </Grid>
    </Border>
</UserControl>
