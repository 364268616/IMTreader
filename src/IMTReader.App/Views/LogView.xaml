<UserControl x:Class="IMTReader.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}"
             FontFamily="{StaticResource UiFontFamily}">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="运行日志" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0" Text="记录导入、识别与错误信息；完整异常堆栈写入日志文件。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource OutlineButton}" Content="复制全部" Click="Copy_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource OutlineButton}" Content="打开日志文件夹" Click="OpenFolder_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource OutlineButton}" Content="清空显示" Click="Clear_Click" />
            </StackPanel>
        </Grid>
        <DataGrid x:Name="Grid" Grid.Row="1" Style="{StaticResource ListGrid}" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="100" />
                <DataGridTextColumn Header="级别" Binding="{Binding LevelText}" Width="70" />
                <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*" MinWidth="240" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LevelText}" Value="错误">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LevelText}" Value="警告">
                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
