<Window x:Class="IMTReader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IMTReader.App"
        xmlns:vm="clr-namespace:IMTReader.App.ViewModels"
        Title="广哥古籍阅读器" Icon="/Resources/app.ico" Height="900" Width="1500" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}" TextOptions.TextFormattingMode="Ideal"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 导航栏 -->
        <Border Grid.Column="0" Background="{StaticResource NavBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 品牌 -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,16,18">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="广" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="广哥古籍阅读器" FontSize="14.5" FontWeight="SemiBold" />
                        <TextBlock Text="本机识读，原图对照" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- 后台任务指示 -->
                <Border DockPanel.Dock="Bottom" Margin="12,8,12,14" Padding="12,10" CornerRadius="7"
                        Background="{StaticResource AccentSoftBrush}" Cursor="Hand"
                        MouseLeftButtonUp="ActiveJob_Click"
                        Visibility="{Binding HasActiveJob, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveJobTitle}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ActiveJobStatus}" FontSize="11" Margin="0,1,0,6"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding ActiveJobProgress, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 导航项 -->
                <StackPanel>
                    <RadioButton x:Name="NavLibrary" GroupName="MainNav" Tag="Library" Checked="Nav_Checked" AutomationProperties.Name="文献库" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" />
                            <TextBlock Text="文献库" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavTasks" GroupName="MainNav" Tag="Tasks" Checked="Nav_Checked" AutomationProperties.Name="任务中心" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;" />
                            <TextBlock Text="任务中心" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHistory" GroupName="MainNav" Tag="History" Checked="Nav_Checked" AutomationProperties.Name="阅读历史" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" />
                            <TextBlock Text="阅读历史" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="工具" Style="{StaticResource NavGroupLabel}" />
                    <Button x:Name="NavEra" AutomationProperties.Name="纪年换算" Style="{StaticResource NavAction}" Click="NavEra_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" />
                            <TextBlock Text="纪年换算" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <RadioButton x:Name="NavLog" GroupName="MainNav" Tag="Log" Checked="Nav_Checked" AutomationProperties.Name="运行日志" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" />
                            <TextBlock Text="运行日志" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="其它" Style="{StaticResource NavGroupLabel}" />
                    <RadioButton x:Name="NavSettings" GroupName="MainNav" Tag="Settings" Checked="Nav_Checked" AutomationProperties.Name="设置" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                            <TextBlock Text="设置" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" GroupName="MainNav" Tag="About" Checked="Nav_Checked" AutomationProperties.Name="关于" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" />
                            <TextBlock Text="关于" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主区域 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 页签 -->
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="10,0,10,0">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TabViewModel}">
                            <ToggleButton Style="{StaticResource TabHeaderButton}" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="TabHeader_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource CloseTabButton}" Click="TabClose_Click"
                                            Visibility="{Binding IsClosable, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}">
                <Grid x:Name="ContentHost" />
            </Border>
        </Grid>
    </Grid>
</Window>
