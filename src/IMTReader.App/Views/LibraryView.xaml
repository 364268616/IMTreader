<UserControl x:Class="IMTReader.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IMTReader.App"
             Background="{StaticResource WindowBackgroundBrush}"
             FontFamily="{StaticResource UiFontFamily}">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="文献库" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0"
                           Text="导入扫描 PDF 或图片后即可本机识别、对照阅读。支持 PNG／JPG／TIFF／BMP，以及整个图片文件夹；也可把文件直接拖进窗口。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource OutlineButton}" Click="ImportImages_Click" Margin="0,0,8,0" AutomationProperties.Name="导入图片">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE91B;" />
                        <TextBlock Text="导入图片" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OutlineButton}" Click="ImportFolder_Click" Margin="0,0,8,0" AutomationProperties.Name="导入文件夹">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" />
                        <TextBlock Text="导入文件夹" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="ImportPdf_Click" AutomationProperties.Name="导入 PDF">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE82E;" Foreground="White" />
                        <TextBlock Text="导入 PDF" Margin="8,0,0,0" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 筛选 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10,0" Width="320" HorizontalAlignment="Left" Margin="0,0,0,14">
            <DockPanel Height="32">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource MutedTextBrush}" />
                <TextBox x:Name="FilterBox" DockPanel.Dock="Left" BorderThickness="0" Background="Transparent" Margin="8,0,0,0"
                         VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" ToolTip="按标题筛选" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid x:Name="Grid" Style="{StaticResource ListGrid}" ItemsSource="{Binding Documents}"
                      MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*" MinWidth="150" />
                    <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="90" />
                    <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" Width="70" />
                    <DataGridTextColumn Header="已识别" Binding="{Binding OcrProgress}" Width="90" />
                    <DataGridTextColumn Header="上次阅读" Binding="{Binding LastOpened}" Width="140" />
                    <DataGridTextColumn Header="导入时间" Binding="{Binding AddedAt}" Width="140" />
                    <DataGridTextColumn Header="来源" Binding="{Binding SourcePath}" Width="2*" MinWidth="150" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SourceMissing}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Setter Property="ToolTip" Value="源文件不存在，请通过右键菜单重新定位" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开阅读" Click="Open_Click" />
                        <MenuItem Header="识别全文" Click="OcrAll_Click" />
                        <MenuItem Header="拓片：识别全文" Click="OcrAllRubbing_Click" />
                        <Separator />
                        <MenuItem Header="重命名…" Click="Rename_Click" />
                        <MenuItem Header="重新定位源文件…" Click="Relocate_Click" />
                        <MenuItem Header="打开所在文件夹" Click="OpenFolder_Click" />
                        <Separator />
                        <MenuItem Header="从文献库移除（保留源文件）" Click="Delete_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- 空状态 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="44"
                           Foreground="#C9CEC9" HorizontalAlignment="Center" />
                <TextBlock Text="文献库还是空的" FontSize="15" Margin="0,14,0,0" HorizontalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Text="导入扫描 PDF 或图片，或把文件拖进窗口" Style="{StaticResource Hint}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
