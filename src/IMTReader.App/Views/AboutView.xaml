<UserControl x:Class="IMTReader.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}"
             FontFamily="{StaticResource UiFontFamily}">
    <UserControl.Resources>
        <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,20,8" />
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Feature" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="TextDecorations" Value="None" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28" MaxWidth="880" HorizontalAlignment="Left">

            <!-- 标识 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="广" Foreground="White" FontSize="34" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ProductText" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="TaglineText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="把古籍扫描件变成可对照、可检索、可批注的文本。识别在本机完成，竖排按阅读顺序转为横排。" />
                </StackPanel>
            </StackPanel>

            <!-- 基本信息 -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Style="{StaticResource Key}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText" Style="{StaticResource Val}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="开发者" Style="{StaticResource Key}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DeveloperText" Style="{StaticResource Val}" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="邮箱" Style="{StaticResource Key}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Val}">
                        <Hyperlink NavigateUri="mailto:364268616@qq.com" RequestNavigate="Link_RequestNavigate">364268616@qq.com</Hyperlink>
                    </TextBlock>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="项目地址" Style="{StaticResource Key}" />
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="GitHub" Style="{StaticResource Val}" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Val}">
                            <Hyperlink NavigateUri="https://github.com/364268616/IMTreader" RequestNavigate="Link_RequestNavigate">github.com/364268616/IMTreader</Hyperlink>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Gitee" Style="{StaticResource Val}" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Val}">
                            <Hyperlink NavigateUri="https://gitee.com/QinGuang/imtreader" RequestNavigate="Link_RequestNavigate">gitee.com/QinGuang/imtreader</Hyperlink>
                        </TextBlock>
                    </Grid>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="运行环境" Style="{StaticResource Key}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RuntimeText" Style="{StaticResource Val}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="识别引擎" Style="{StaticResource Key}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="EngineText" Style="{StaticResource Val}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="许可证" Style="{StaticResource Key}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Val}" Text="MIT License（开源免费）" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="版权" Style="{StaticResource Key}" />
                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="CopyrightText" Style="{StaticResource Val}" />
                </Grid>
            </Border>

            <!-- 主要功能 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="能做什么" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <UniformGrid Columns="2">
                        <TextBlock Style="{StaticResource Feature}" Text="· 本机识别 PDF 与图片，竖排按阅读顺序转为横排" />
                        <TextBlock Style="{StaticResource Feature}" Text="· 原图与文本左右对照，点击互相定位，识别结果可改" />
                        <TextBlock Style="{StaticResource Feature}" Text="· 繁简一键切换显示；检索时简繁、异体互通" />
                        <TextBlock Style="{StaticResource Feature}" Text="· 高亮、书签、笔记与出处引用" />
                        <TextBlock Style="{StaticResource Feature}" Text="· 拓片反白、框选补识、按页范围识别" />
                        <TextBlock Style="{StaticResource Feature}" Text="· 竖排仿古书版式沉浸阅读" />
                        <TextBlock Style="{StaticResource Feature}" Text="· 年号、干支与公元互转" />
                        <TextBlock Style="{StaticResource Feature}" Text="· 导出全文、高亮摘录与笔记" />
                        <TextBlock Style="{StaticResource Feature}" Text="· 可选接入大模型做标点、翻译与注释" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 请咖啡 -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="请我喝杯咖啡" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="这是我个人做的开源项目，一直免费，为爱发电。用得顺手的话，请我喝杯咖啡就好。" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="微信扫右边的码即可。不请也完全没问题，程序照样用。" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6" VerticalAlignment="Center">
                        <Image Source="/Resources/donate-wechat.jpg" Width="200" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"
                               ToolTip="微信扫码请广哥喝杯咖啡" />
                    </Border>
                </Grid>
            </Border>

            <!-- 开源组件与目录 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="开源组件与本机目录" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                               Text="本程序使用的第三方组件均为可商用的开源许可证（Apache-2.0 / MIT / BSD），完整清单与许可证全文见第三方组件声明。" />
                    <WrapPanel>
                        <Button Style="{StaticResource OutlineButton}" Click="Notices_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" />
                                <TextBlock Text="第三方组件声明" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" Click="DataDir_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" />
                                <TextBlock Text="数据目录" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" Click="LogDir_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" />
                                <TextBlock Text="日志目录" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
