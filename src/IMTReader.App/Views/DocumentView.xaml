<UserControl x:Class="IMTReader.App.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IMTReader.App"
             xmlns:ctl="clr-namespace:IMTReader.App.Controls"
             xmlns:vm="clr-namespace:IMTReader.App.ViewModels"
             Background="{StaticResource WindowBackgroundBrush}"
             FontFamily="{StaticResource UiFontFamily}" Focusable="True">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="TbLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏：翻页 / 视图 / 识别 / 文本 / 更多 -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Click="Prev_Click" IsEnabled="{Binding CanGoPrev}" ToolTip="上一页" AutomationProperties.Name="上一页">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" />
                    </Button>
                    <TextBox x:Name="PageBox" Style="{StaticResource SmallTextBox}" Text="{Binding PageNumber, Mode=OneWay}"
                             KeyDown="PageBox_KeyDown" ToolTip="输入页码后回车" />
                    <TextBlock Text="{Binding PageLabel}" Style="{StaticResource TbLabel}" />
                    <Button Style="{StaticResource ToolButton}" Click="Next_Click" IsEnabled="{Binding CanGoNext}" ToolTip="下一页" AutomationProperties.Name="下一页">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" />
                    </Button>

                    <Border Style="{StaticResource Separator}" />

                    <Button Style="{StaticResource ToolButton}" Click="ZoomOut_Click" ToolTip="缩小（Ctrl+-）" AutomationProperties.Name="缩小">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" />
                    </Button>
                    <TextBlock Text="{Binding ZoomText}" Style="{StaticResource TbLabel}" MinWidth="38" TextAlignment="Center" />
                    <Button Style="{StaticResource ToolButton}" Click="ZoomIn_Click" ToolTip="放大（Ctrl++）" AutomationProperties.Name="放大">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="FitWidth_Click" ToolTip="适合宽度（Ctrl+0）" AutomationProperties.Name="适合宽度">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="RotateLeft_Click" ToolTip="逆时针旋转 90°" AutomationProperties.Name="逆时针旋转">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="RotateRight_Click" ToolTip="顺时针旋转 90°" AutomationProperties.Name="顺时针旋转">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
                    </Button>

                    <Border Style="{StaticResource Separator}" />

                    <Button x:Name="OcrButton" Style="{StaticResource PrimaryButton}" Click="Ocr_Click" ToolTip="识别当前页、全文、范围或拓片（F5 识别当前页）" AutomationProperties.Name="识别">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FE;" Foreground="White" />
                            <TextBlock Text="识别" Margin="8,0,6,0" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding IsSelectMode, Mode=TwoWay}"
                                  ToolTip="框选识别：在原图上拖拽出区域，结果追加到本页" AutomationProperties.Name="框选识别">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7A8;" />
                            <TextBlock Text="框选" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Border Style="{StaticResource Separator}" />

                    <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding ShowSimplified, Mode=TwoWay}" ToolTip="繁体、简体切换显示" AutomationProperties.Name="繁简切换">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" />
                            <TextBlock Text="繁→简" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource ToolButton}" Click="Highlight_Click" ToolTip="高亮选中文字（Ctrl+H）" AutomationProperties.Name="高亮">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE891;" />
                            <TextBlock Text="高亮" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Search_Click" ToolTip="全文搜索（Ctrl+F）" AutomationProperties.Name="搜索">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" />
                            <TextBlock Text="搜索" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Notes_Click" ToolTip="笔记（Ctrl+N）" AutomationProperties.Name="笔记">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70B;" />
                            <TextBlock Text="笔记" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                    <Button x:Name="MoreButton" Style="{StaticResource ToolButton}" Click="More_Click"
                            AutomationProperties.Name="更多" ToolTip="书签、朗读、AI 助手、沉浸阅读、导出、图像增强…">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" />
                            <TextBlock Text="更多" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="Save_Click"
                            AutomationProperties.Name="保存修改" ToolTip="把编辑与高亮写回本页识别结果（Ctrl+S）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Foreground="White" />
                            <TextBlock Text="保存修改" Margin="8,0,0,0" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主区域：缩略图 / 原图 / 识别文本 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="3*" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ThumbList" Grid.Column="0" ItemsSource="{Binding Thumbnails}"
                     Background="{StaticResource NavBackgroundBrush}" BorderThickness="0,0,1,0"
                     BorderBrush="{StaticResource DividerBrush}" SelectionChanged="ThumbList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" Padding="0,6"
                     VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,5" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="7" Margin="6,2">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PageThumbViewModel}">
                        <Border Loaded="Thumb_Loaded" Width="96">
                            <StackPanel>
                                <Grid>
                                    <Border Background="White" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" MinHeight="58">
                                        <Image Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly" />
                                    </Border>
                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="7" Width="15" Height="15"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                            Visibility="{Binding HasOcr, Converter={StaticResource BoolToVis}}" ToolTip="已识别">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#D89B2C"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0"
                                               Visibility="{Binding IsBookmarked, Converter={StaticResource BoolToVis}}" ToolTip="书签" />
                                </Grid>
                                <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ctl:PageViewer x:Name="Viewer" Grid.Column="1"
                            Source="{Binding CurrentImage}"
                            Blocks="{Binding BlockModels}"
                            SelectedBlock="{Binding SelectedBlockModel}"
                            Zoom="{Binding Zoom, Mode=TwoWay}"
                            Rotation="{Binding Rotation}"
                            ShowBoxes="{Binding ShowBoxes}"
                            IsSelectMode="{Binding IsSelectMode}" />

            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource DividerBrush}" />

            <Border Grid.Column="3" Background="{DynamicResource ReadingBackgroundBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{Binding BlocksHeader}" FontWeight="SemiBold" FontSize="13.5" />
                                <TextBlock Text="{Binding EditHint}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource ToolButton}" Click="FontSmaller_Click" ToolTip="减小文字" Padding="7,4" AutomationProperties.Name="减小文字">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource ToolButton}" Click="FontLarger_Click" ToolTip="增大文字" Padding="7,4" AutomationProperties.Name="增大文字">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer x:Name="BlocksScroll" VerticalScrollBarVisibility="Auto" Padding="14,12,14,14">
                        <ItemsControl x:Name="BlocksItems" ItemsSource="{Binding Blocks}"
                                      ctl:BlockEditor.Activated="Editor_Activated"
                                      ctl:BlockEditor.ContentEdited="Editor_ContentEdited"
                                      ctl:BlockEditor.ActionRequested="Editor_ActionRequested">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BlockViewModel}">
                                    <ctl:BlockEditor FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding OcrSummary}" FontSize="12"
                           Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding OcrStatusText}" FontSize="12" Margin="0,0,18,0"
                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
