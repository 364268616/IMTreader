<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- 仅面向 Windows x64：只复制 win-x64 原生库，避免带上其它平台的运行时 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>portable</DebugType>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <Version>1.0.0</Version>
    <!-- 开发者信息：显示在“关于”页，改这里即可 -->
    <Authors>广哥</Authors>
    <Company>广哥</Company>
    <Product>广哥古籍阅读器</Product>
    <Description>本机古籍扫描件识读工具。原图对照阅读，竖排按阅读顺序转为横排。</Description>
    <Copyright>© 2026 广哥</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
